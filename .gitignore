# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Secrets
.env
.env.*

# FastF1 session cache: large, re-downloadable, never committed
cache/

# Packaging artifacts from `pip install -e .`
*.egg-info/
build/
dist/

# Derived data stays out of git, with one exception: the precomputed model
# results the MCP server reads. Those are committed so the server works on a
# fresh clone, which matters now that the data source needs an account.
data/*
!data/model_outputs.json

# Tooling
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.Rhistory
.vscode/
